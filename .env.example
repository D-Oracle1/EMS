# Hylink Finance EMS - Environment Variables
# Copy this file to .env and update values for your environment

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/hylink_ems?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/hylink_ems?schema=public

# NextAuth v5 Configuration
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Legacy NextAuth (fallback)
NEXTAUTH_SECRET=same-as-auth-secret
NEXTAUTH_URL=http://localhost:3000

# Security
BCRYPT_ROUNDS=12

# Cron Job Protection (set a random secret and pass it as Bearer token)
CRON_SECRET=generate-a-random-secret-here

# App
NODE_ENV=development
