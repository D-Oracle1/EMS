  oldValues     Json? // Previous state
  newValues     Json? // New state
  changedFields String[] // List of changed fields

  // Context
  ipAddress String?
  userAgent String?
  sessionId String?

  // Additional metadata
  metadata Json?

  createdAt DateTime @default(now())

  user Staff? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  EXPORT
  PRINT
  REVERSAL
}

// Approval Workflow History
model ApprovalHistory {
  id String @id @default(uuid())

  entityType String // LOAN, JOURNAL, DOCUMENT, etc.
  entityId   String

  workflowStep String
  stepOrder    Int

  action    ApprovalAction
  actorId   String
  actorRole String

  comments   String?
  conditions String?

  previousStatus String?
  newStatus      String

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  ESCALATED
  RECALLED
}

// System Notifications
model Notification {
  id String @id @default(uuid())

  userId String

  type    NotificationType
  title   String
  message String

  entityType String?
  entityId   String?
  actionUrl  String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  APPROVAL_REQUIRED
  TASK_ASSIGNED
  PAYMENT_RECEIVED
  LOAN_OVERDUE
  MATURITY_REMINDER
}

// Sequence Generator for Reference Numbers
model Sequence {
  id             String    @id @default(uuid())
  code           String    @unique
  prefix         String
  currentValue   Int       @default(0)
  padLength      Int       @default(6)
  resetFrequency String? // DAILY, MONTHLY, YEARLY, NEVER
  lastResetAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============================================================================
// HR — WORKFORCE CONFIGURATION
// ============================================================================

// Configurable leave types (replaces the free-text LeaveRequest.leaveType)
model LeaveType {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  defaultDays         Decimal @default(0) @db.Decimal(6, 2)
  isPaid              Boolean @default(true)
  requiresApproval    Boolean @default(true)
  requiresDocument    Boolean @default(false)
  allowHalfDay        Boolean @default(false)
  carryForward        Boolean @default(false)
  maxCarryForwardDays Decimal @default(0) @db.Decimal(6, 2)
  maxConsecutiveDays  Int?
  minServiceMonths    Int     @default(0)
  genderRestriction   String? // MALE, FEMALE, or null for all
  countsWeekends      Boolean @default(false)
  colorHex            String? @default("#64748b")
  sortOrder           Int     @default(0)
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@index([isActive])
}

// Per-staff, per-year leave entitlement ledger
model LeaveBalance {
  id          String @id @default(uuid())
  staffId     String
  leaveTypeId String
  year        Int

  entitledDays       Decimal @default(0) @db.Decimal(6, 2)
  carriedForwardDays Decimal @default(0) @db.Decimal(6, 2)
  accruedDays        Decimal @default(0) @db.Decimal(6, 2)
  usedDays           Decimal @default(0) @db.Decimal(6, 2)
  pendingDays        Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff     @relation(fields: [staffId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([staffId, leaveTypeId, year])
  @@index([year])
}

// Public / company holiday calendar
model Holiday {
  id           String   @id @default(uuid())
  name         String
  date         DateTime @db.Date
  isRecurring  Boolean  @default(false) // repeats same day/month each year
  isWorkingDay Boolean  @default(false) // e.g. declared work-from-home day
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, date])
  @@index([date])
}

// Work shifts / rosters
model WorkShift {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  startTime    String // "08:00"
  endTime      String // "17:00"
  graceMinutes Int     @default(15)
  breakMinutes Int     @default(60)
  workDays     Int[] // 0=Sun .. 6=Sat
  branchId     String?
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch      Branch?           @relation(fields: [branchId], references: [id])
  assignments ShiftAssignment[]
  attendance  Attendance[]

  @@index([isActive])
}

model ShiftAssignment {
  id            String    @id @default(uuid())
  staffId       String
  shiftId       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())

  staff Staff     @relation(fields: [staffId], references: [id])
  shift WorkShift @relation(fields: [shiftId], references: [id])

  @@index([staffId])
  @@index([shiftId])
}

// ============================================================================
// HR — COMPENSATION & PAYROLL
// ============================================================================

model SalaryGrade {
  id              String  @id @default(uuid())
  code            String  @unique
  name            String
  level           Int     @default(0)
  minGross        Decimal @default(0) @db.Decimal(18, 2)
  maxGross        Decimal @default(0) @db.Decimal(18, 2)
  annualLeaveDays Decimal @default(0) @db.Decimal(6, 2)
  description     String?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff         Staff[]
  compensations StaffCompensation[]
  jobOpenings   JobOpening[]

  @@index([isActive])
}

enum PayrollComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum PayrollCalculationType {
  FIXED
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
}

// Reusable payroll building blocks (basic, housing, PAYE, pension, ...)
model PayrollComponent {
  id              String                 @id @default(uuid())
  code            String                 @unique
  name            String
  type            PayrollComponentType
  calculationType PayrollCalculationType @default(FIXED)
  defaultValue    Decimal                @default(0) @db.Decimal(18, 4)
  isTaxable       Boolean                @default(true)
  isStatutory     Boolean                @default(false)
  isPensionable   Boolean                @default(false)
  glAccountCode   String? // maps to ChartOfAccounts.accountCode for posting
  sortOrder       Int                    @default(0)
  isActive        Boolean                @default(true)
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compensationItems StaffCompensationItem[]

  @@index([type])
  @@index([isActive])
}

// A staff member's salary package. History is kept; isCurrent marks the live row.
model StaffCompensation {
  id      String  @id @default(uuid())
  staffId String
  gradeId String?

  basicSalary  Decimal @db.Decimal(18, 2)
  currency     String  @default("NGN")
  payFrequency String  @default("MONTHLY")

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isCurrent     Boolean   @default(true)

  reason      String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff                   @relation("CompensationStaff", fields: [staffId], references: [id])
  createdBy Staff                   @relation("CompensationCreatedBy", fields: [createdById], references: [id])
  grade     SalaryGrade?            @relation(fields: [gradeId], references: [id])
  items     StaffCompensationItem[]

  @@index([staffId])
  @@index([isCurrent])
}

model StaffCompensationItem {
  id             String @id @default(uuid())
  compensationId String
  componentId    String

  // Either a flat amount or a percentage, per the component's calculationType
  amount     Decimal? @db.Decimal(18, 2)
  percentage Decimal? @db.Decimal(7, 4)

  compensation StaffCompensation @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  component    PayrollComponent  @relation(fields: [componentId], references: [id])

  @@unique([compensationId, componentId])
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

model PayrollPeriod {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. "2026-09"
  year      Int
  month     Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  payDate   DateTime @db.Date

  status PayrollStatus @default(DRAFT)

  staffCount        Int     @default(0)
  totalGross        Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions   Decimal @default(0) @db.Decimal(18, 2)
  totalNet          Decimal @default(0) @db.Decimal(18, 2)
  totalEmployerCost Decimal @default(0) @db.Decimal(18, 2)

  processedById String?
  processedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?

  journalEntryId String? // GL posting for the payroll accrual
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processedBy Staff?    @relation("PayrollProcessedBy", fields: [processedById], references: [id])
  approvedBy  Staff?    @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  payslips    Payslip[]

  @@unique([year, month])
  @@index([status])
}

model Payslip {
  id              String @id @default(uuid())
  payslipNumber   String @unique
  payrollPeriodId String
  staffId         String

  basicSalary     Decimal @db.Decimal(18, 2)
  grossEarnings   Decimal @db.Decimal(18, 2)
  totalDeductions Decimal @db.Decimal(18, 2)
  netPay          Decimal @db.Decimal(18, 2)
  employerCost    Decimal @default(0) @db.Decimal(18, 2)

  workingDays Int     @default(0)
  daysPresent Int     @default(0)
  daysAbsent  Int     @default(0)
  lopDays     Decimal @default(0) @db.Decimal(6, 2)
  lopAmount   Decimal @default(0) @db.Decimal(18, 2)

  // Snapshot of pay details at run time
  bankName          String?
  bankAccountNumber String?
  gradeName         String?
  jobTitle          String?

  createdAt DateTime @default(now())

  period PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  staff  Staff         @relation(fields: [staffId], references: [id])
  lines  PayslipLine[]

  @@unique([payrollPeriodId, staffId])
  @@index([staffId])
}

model PayslipLine {
  id        String @id @default(uuid())
  payslipId String

  componentCode String
  componentName String
  type          PayrollComponentType
  amount        Decimal              @db.Decimal(18, 2)
  glAccountCode String?
  sortOrder     Int                  @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

// ============================================================================
// HR — RECRUITMENT
// ============================================================================

enum JobOpeningStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  FILLED
  CANCELLED
}

model JobOpening {
  id           String  @id @default(uuid())
  code         String  @unique
  title        String
  departmentId String
  branchId     String?
  gradeId      String?

  description      String
  requirements     String?
  responsibilities String?
  employmentType   EmploymentType @default(FULL_TIME)

  vacancies   Int @default(1)
  filledCount Int @default(0)

  minSalary Decimal? @db.Decimal(18, 2)
  maxSalary Decimal? @db.Decimal(18, 2)

  status      JobOpeningStatus @default(DRAFT)
  openedAt    DateTime?
  closingDate DateTime?
  closedAt    DateTime?

  hiringManagerId String?
  createdById     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department    Department       @relation(fields: [departmentId], references: [id])
  branch        Branch?          @relation(fields: [branchId], references: [id])
  grade         SalaryGrade?     @relation(fields: [gradeId], references: [id])
  hiringManager Staff?           @relation("HiringManager", fields: [hiringManagerId], references: [id])
  applications  JobApplication[]

  @@index([status])
  @@index([departmentId])
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEWING
  OFFER_SENT
  OFFER_ACCEPTED
  HIRED
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id                String @id @default(uuid())
  applicationNumber String @unique
  openingId         String

  firstName String
  lastName  String
  email     String
  phone     String
  address   String?

  resumeUrl            String?
  coverLetter          String?
  yearsExperience      Int?
  currentEmployer      String?
  currentPosition      String?
  expectedSalary       Decimal? @db.Decimal(18, 2)
  noticePeriodDays     Int?
  highestQualification String?
  source               String? // REFERRAL, WEBSITE, AGENCY, WALK_IN, LINKEDIN

  status          ApplicationStatus @default(APPLIED)
  rating          Int? // 1-5 screening rating
  screeningNotes  String?
  rejectionReason String?

  hiredStaffId String?
  hiredAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opening    JobOpening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
  hiredStaff Staff?      @relation("HiredStaff", fields: [hiredStaffId], references: [id])
  interviews Interview[]

  @@index([openingId])
  @@index([status])
  @@index([email])
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  NEUTRAL
  NO_HIRE
  STRONG_NO_HIRE
}

model Interview {
  id            String @id @default(uuid())
  applicationId String

  stage           String // SCREENING, TECHNICAL, PANEL, FINAL
  stageOrder      Int      @default(1)
  scheduledAt     DateTime
  durationMinutes Int      @default(45)
  mode            String   @default("IN_PERSON") // IN_PERSON, VIDEO, PHONE
  location        String?

  interviewerId String?
  status        InterviewStatus @default(SCHEDULED)

  score          Int? // 1-100
  feedback       String?
  recommendation InterviewRecommendation?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer Staff?         @relation("Interviewer", fields: [interviewerId], references: [id])

  @@index([applicationId])
  @@index([scheduledAt])
}

// ============================================================================
// HR — ONBOARDING / OFFBOARDING
// ============================================================================

enum OnboardingType {
  ONBOARDING
  OFFBOARDING
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

model OnboardingTemplate {
  id           String         @id @default(uuid())
  name         String
  type         OnboardingType @default(ONBOARDING)
  departmentId String?
  description  String?
  isActive     Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department  Department?              @relation(fields: [departmentId], references: [id])
  tasks       OnboardingTemplateTask[]
  onboardings StaffOnboarding[]
}

model OnboardingTemplateTask {
  id         String @id @default(uuid())
  templateId String

  title         String
  description   String?
  category      String  @default("GENERAL") // IT, HR, FINANCE, COMPLIANCE, TRAINING, GENERAL
  dueDayOffset  Int     @default(0) // days from start date
  ownerRoleCode String? // role responsible by default
  isMandatory   Boolean @default(true)
  sortOrder     Int     @default(0)

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model StaffOnboarding {
  id         String           @id @default(uuid())
  staffId    String
  templateId String?
  type       OnboardingType   @default(ONBOARDING)
  status     OnboardingStatus @default(NOT_STARTED)

  startDate   DateTime  @db.Date
  targetDate  DateTime? @db.Date
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff    Staff               @relation("OnboardingStaff", fields: [staffId], references: [id])
  template OnboardingTemplate? @relation(fields: [templateId], references: [id])
  tasks    OnboardingTask[]

  @@index([staffId])
  @@index([status])
}

model OnboardingTask {
  id           String @id @default(uuid())
  onboardingId String

  title       String
  description String?
  category    String    @default("GENERAL")
  dueDate     DateTime? @db.Date
  isMandatory Boolean   @default(true)
  sortOrder   Int       @default(0)

  status        OnboardingTaskStatus @default(PENDING)
  assigneeId    String?
  completedById String?
  completedAt   DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding  StaffOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  assignee    Staff?          @relation("OnboardingAssignee", fields: [assigneeId], references: [id])
  completedBy Staff?          @relation("OnboardingCompletedBy", fields: [completedById], references: [id])

  @@index([onboardingId])
  @@index([assigneeId])
  @@index([status])
}

// ============================================================================
// HR — LEARNING & DEVELOPMENT
// ============================================================================

enum TrainingStatus {
  PLANNED
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  NOMINATED
  ENROLLED
  ATTENDED
  COMPLETED
  FAILED
  CANCELLED
  NO_SHOW
}

model TrainingProgram {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?
  category    String  @default("GENERAL") // COMPLIANCE, TECHNICAL, LEADERSHIP, ONBOARDING, SOFT_SKILLS
  provider    String?
  mode        String  @default("IN_PERSON") // IN_PERSON, ONLINE, HYBRID

  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  venue       String?
  capacity    Int?
  costPerSeat Decimal? @db.Decimal(18, 2)
  isMandatory Boolean  @default(false)
  passMark    Int?     @default(50)

  facilitatorId String?
  status        TrainingStatus @default(PLANNED)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facilitator Staff?               @relation("TrainingFacilitator", fields: [facilitatorId], references: [id])
  enrollments TrainingEnrollment[]

  @@index([status])
  @@index([startDate])
}

model TrainingEnrollment {
  id        String @id @default(uuid())
  programId String
  staffId   String

  status         EnrollmentStatus @default(NOMINATED)
  attendedAt     DateTime?
  completedAt    DateTime?
  score          Int?
  passed         Boolean?
  feedback       String?
  certificateUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  staff   Staff           @relation(fields: [staffId], references: [id])

  @@unique([programId, staffId])
  @@index([staffId])
}

// ============================================================================
// HR — COMPANY ASSETS
// ============================================================================

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
  LOST
  DAMAGED
}

model CompanyAsset {
  id           String  @id @default(uuid())
  assetTag     String  @unique
  name         String
  category     String  @default("IT") // IT, FURNITURE, VEHICLE, PHONE, TOOLS, OTHER
  make         String?
  model        String?
  serialNumber String?

  purchaseDate  DateTime? @db.Date
  purchaseCost  Decimal?  @db.Decimal(18, 2)
  warrantyUntil DateTime? @db.Date

  condition String      @default("GOOD") // NEW, GOOD, FAIR, POOR
  status    AssetStatus @default(AVAILABLE)
  branchId  String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch      Branch?           @relation(fields: [branchId], references: [id])
  assignments AssetAssignment[]

  @@index([status])
  @@index([category])
}

model AssetAssignment {
  id      String @id @default(uuid())
  assetId String
  staffId String

  assignedAt     DateTime  @default(now())
  assignedById   String
  dueReturnAt    DateTime? @db.Date
  acknowledgedAt DateTime?

  returnedAt      DateTime?
  returnCondition String?
  returnNotes     String?
  notes           String?

  asset      CompanyAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  staff      Staff        @relation("AssetHolder", fields: [staffId], references: [id])
  assignedBy Staff        @relation("AssetIssuer", fields: [assignedById], references: [id])

  @@index([assetId])
  @@index([staffId])
}

// ============================================================================
// HR — INTERNAL COMMUNICATION
// ============================================================================

enum AnnouncementAudience {
  ALL
  DEPARTMENT
  BRANCH
  ROLE
}

model Announcement {
  id       String @id @default(uuid())
  title    String
  body     String
  category String @default("GENERAL") // POLICY, EVENT, HOLIDAY, EMERGENCY, GENERAL
  priority String @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  audienceType AnnouncementAudience @default(ALL)
  audienceId   String? // departmentId / branchId / roleId depending on audienceType

  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  expiresAt     DateTime?
  requiresAck   Boolean   @default(false)
  pinned        Boolean   @default(false)
  attachmentUrl String?

  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author           Staff             @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  acknowledgements AnnouncementAck[]

  @@index([isPublished, publishedAt])
}

model AnnouncementAck {
  id             String   @id @default(uuid())
  announcementId String
  staffId        String
  acknowledgedAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id])

  @@unique([announcementId, staffId])
}

// ============================================================================
// HR — EMPLOYEE LIFECYCLE
// ============================================================================

enum MovementType {
  PROMOTION
  DEMOTION
  TRANSFER
  CONFIRMATION
  ROLE_CHANGE
  DEPARTMENT_CHANGE
  SALARY_REVIEW
  SUSPENSION
  REINSTATEMENT
  CONTRACT_RENEWAL
  EXIT
}

model StaffMovement {
  id            String       @id @default(uuid())
  staffId       String
  type          MovementType
  effectiveDate DateTime     @db.Date

  fromRoleId       String?
  toRoleId         String?
  fromDepartmentId String?
  toDepartmentId   String?
  fromBranchId     String?
  toBranchId       String?
  fromGradeId      String?
  toGradeId        String?
  fromSalary       Decimal? @db.Decimal(18, 2)
  toSalary         Decimal? @db.Decimal(18, 2)
  fromJobTitle     String?
  toJobTitle       String?

  reason      String
  remarks     String?
  documentUrl String?

  createdById String
  createdAt   DateTime @default(now())

  staff     Staff @relation("MovementStaff", fields: [staffId], references: [id])
  createdBy Staff @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([staffId])
  @@index([type])
  @@index([effectiveDate])
}

enum ExitType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  CONTRACT_END
  REDUNDANCY
  DEATH
  ABANDONMENT
}

enum ClearanceStatus {
  PENDING
  IN_PROGRESS
  CLEARED
  BLOCKED
}

model StaffExit {
  id      String   @id @default(uuid())
  staffId String   @unique
  type    ExitType

  noticeDate     DateTime @db.Date
  lastWorkingDay DateTime @db.Date
  reason         String
  detailedReason String?

  exitInterviewDate  DateTime?
  exitInterviewNotes String?
  wouldRecommend     Boolean?
  rehireEligible     Boolean   @default(true)

  clearanceStatus   ClearanceStatus @default(PENDING)
  assetsReturned    Boolean         @default(false)
  handoverCompleted Boolean         @default(false)
  accessRevoked     Boolean         @default(false)

  finalSettlementAmount Decimal?  @db.Decimal(18, 2)
  settledAt             DateTime?

  processedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staff       Staff @relation("ExitStaff", fields: [staffId], references: [id])
  processedBy Staff @relation("ExitProcessedBy", fields: [processedById], references: [id])

  @@index([clearanceStatus])
}

enum GoalStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  MISSED
  CANCELLED
}

model StaffGoal {
  id      String @id @default(uuid())
  staffId String

  title       String
  description String?
  category    String   @default("PERFORMANCE") // PERFORMANCE, DEVELOPMENT, BEHAVIOURAL, PROJECT
  targetValue Decimal? @db.Decimal(18, 2)
  actualValue Decimal? @db.Decimal(18, 2)
  unit        String?
  weight      Int      @default(10) // percentage weight in review

  startDate    DateTime   @db.Date
  dueDate      DateTime   @db.Date
  status       GoalStatus @default(DRAFT)
  progress     Int        @default(0) // 0-100
  ratedScore   Int? // 1-5 at review time
  reviewPeriod String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff     Staff @relation("GoalStaff", fields: [staffId], references: [id])
  createdBy Staff @relation("GoalCreatedBy", fields: [createdById], references: [id])

  @@index([staffId])
  @@index([status])
}

// ============================================================================
// CMS — MARKETING SITE CONTENT
// ============================================================================
// Content for the public website, edited here and read by the static site over
// a public JSON endpoint. Owned by the IT department.

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  excerpt    String?
  body       String
  coverImage String?
  category   String   @default("GENERAL") // NEWS, INSIGHT, PRODUCT, GENERAL
  tags       String[]

  status       PostStatus @default(DRAFT)
  publishedAt  DateTime?
  // Set on a SCHEDULED post; the publish job releases it once this passes.
  scheduledFor DateTime?

  // Denormalised so a published post keeps its byline even if the author
  // record is later deactivated.
  authorId   String
  authorName String

  seoTitle       String?
  seoDescription String?

  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author Staff @relation("PostAuthor", fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@index([category])
}

/// A single editable piece of copy on the marketing site, addressed by the page
/// and slot it fills — so the website asks for "home.hero.title" rather than
/// needing to know a database id.
model ContentBlock {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "home.hero.title"
  page        String // home, about, services, company, contact
  label       String // Human-readable name shown in the editor
  description String? // Guidance for whoever edits it
  type        String  @default("TEXT") // TEXT, RICHTEXT, IMAGE, NUMBER, URL

  value        String
  /// The value as originally shipped, so an edit can always be reverted.
  defaultValue String?

  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy Staff? @relation("ContentBlockEditor", fields: [updatedById], references: [id])

  @@index([page])
}

/// An append-only record of content changes, so a bad edit on the public site
/// can be traced to a person and rolled back.
model ContentRevision {
  id          String @id @default(uuid())
  entityType  String // CONTENT_BLOCK, BLOG_POST
  entityId    String
  entityLabel String

  field    String
  oldValue String?
  newValue String?

  changedById String
  changedAt   DateTime @default(now())

  changedBy Staff @relation("ContentReviser", fields: [changedById], references: [id])

  @@index([entityType, entityId])
  @@index([changedAt])
}
