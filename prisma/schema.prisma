// ============================================================================
// SAVINGS MODULE
// ============================================================================

// Savings Products Configuration
model SavingsProduct {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  savingsType SavingsType

  minBalance         Decimal  @default(0) @db.Decimal(18, 2)
  maxBalance         Decimal? @db.Decimal(18, 2)
  minDeposit         Decimal  @default(0) @db.Decimal(18, 2)
  maxDailyWithdrawal Decimal? @db.Decimal(18, 2)

  interestRate      Decimal           @default(0) @db.Decimal(5, 2)
  interestFrequency InterestFrequency @default(MONTHLY)

  allowWithdrawal  Boolean @default(true)
  withdrawalNotice Int     @default(0) // Days

  monthlyFee     Decimal @default(0) @db.Decimal(18, 2)
  transactionFee Decimal @default(0) @db.Decimal(18, 2)

  // Fixed-Term Savings Engine Configuration
  durationMonths                 Int?
  totalInterestRate              Decimal?                  @db.Decimal(5, 2) // Total rate for full term
  monthlyInterestRate            Decimal?                  @db.Decimal(9, 6) // Auto: totalInterestRate / durationMonths
  interestCalculationMethod      InterestCalculationMethod @default(MATURITY_ONLY)
  interestEligibilityDelayMonths Int                       @default(0) // Months before deposits earn interest
  allowEarlyTermination          Boolean                   @default(false)
  defaultTerminationPenaltyRate  Decimal?                  @db.Decimal(5, 2) // % penalty on approved interest
  createdById                    String?

  // ── Promotional rate ──────────────────────────────────────────────────────
  /// A promo lifts the rate for savers who OPEN an account inside the window.
  /// The rate is stamped onto the account at opening (SavingsAccount.contracted*),
  /// so a saver keeps the promo rate for their whole term and ending the promo
  /// never touches anyone who already joined.
  promoName              String?
  promoTotalInterestRate Decimal?  @db.Decimal(5, 2) // Total rate for the full term
  promoStartsAt          DateTime?
  promoEndsAt            DateTime?
  promoActive            Boolean   @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts SavingsAccount[]

  // Accounting Configuration
  liabilityAccountId       String?
  interestExpenseAccountId String?
}

enum SavingsType {
  DAILY
  TARGET
  FIXED
  CORPORATE
  JUNIOR
  CURRENT
}

enum InterestFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// How a fixed-term product's interest is calculated & applied
enum InterestCalculationMethod {
  MATURITY_ONLY // Accrue monthly, pay lump sum at maturity (default)
  MONTHLY_ALLOCATION // Credit interest to the account balance each month
  FLAT // Flat rate (provisional — treated as maturity accrual for now)
  COMPOUND // Interest compounds into the eligible balance monthly
}

// Savings Accounts
model SavingsAccount {
  id            String @id @default(uuid())
  accountNumber String @unique

  customerId String
  productId  String
  branchId   String?

  currentBalance   Decimal @default(0) @db.Decimal(18, 2)
  availableBalance Decimal @default(0) @db.Decimal(18, 2)
  holdAmount       Decimal @default(0) @db.Decimal(18, 2)

  // For Target Savings
  targetAmount Decimal?  @db.Decimal(18, 2)
  targetDate   DateTime?

  interestAccrued  Decimal   @default(0) @db.Decimal(18, 2)
  lastInterestDate DateTime?

  // Fixed-Term Savings Fields
  eligibleBalance Decimal   @default(0) @db.Decimal(18, 2) // Balance currently earning interest
  pendingDeposits Decimal   @default(0) @db.Decimal(18, 2) // Deposits awaiting next month roll
  totalDeposits   Decimal   @default(0) @db.Decimal(18, 2) // Cumulative deposits ever made
  startDate       DateTime?
  maturityDate    DateTime?
  monthsCompleted Int       @default(0) // Months elapsed of the fixed term
  monthsRemaining Int? // Months left until maturity
  createdById     String?

  // ── Terms contracted at opening ───────────────────────────────────────────
  /// What this saver actually signed up for. Interest is computed from these,
  /// never from the live product, so editing or replacing a product cannot
  /// rewrite what an existing saver earns. Null on accounts opened before this
  /// existed; the engine falls back to the product for those.
  contractedTotalRate      Decimal? @db.Decimal(5, 2)
  contractedMonthlyRate    Decimal? @db.Decimal(9, 6)
  contractedDurationMonths Int?
  /// Set when the account was opened inside a promo window.
  isPromoRate              Boolean  @default(false)
  promoName                String?

  status AccountStatus @default(ACTIVE)

  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  lastTransactionAt DateTime?

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  product  SavingsProduct @relation(fields: [productId], references: [id])
  branch   Branch?        @relation(fields: [branchId], references: [id])

  transactions       SavingsTransaction[]
  withdrawalRequests WithdrawalRequest[]
  terminations       SavingsTermination[]
  journalEntries     JournalEntry[]
  interestPostings   SavingsInterest[]

  @@index([accountNumber])
  @@index([customerId])
  @@index([status])
  @@index([maturityDate])
}

// Immutable per-account monthly interest ledger.
// The unique (accountId, year, month) constraint guarantees interest is
// never posted twice for the same account in the same period.
model SavingsInterest {
  id        String @id @default(uuid())
  accountId String
  year      Int
  month     Int // 1-12

  eligibleBalance Decimal @db.Decimal(18, 2) // Base the interest was computed on
  interestRate    Decimal @db.Decimal(9, 6) // Monthly rate applied
  interestAmount  Decimal @db.Decimal(18, 2)

  calculationMethod InterestCalculationMethod @default(MATURITY_ONLY)
  status            InterestPostingStatus     @default(ACCRUED)

  transactionId String? // Linked SavingsTransaction, if any
  generatedById String?
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  account SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, year, month])
  @@index([accountId])
  @@index([year, month])
  @@index([status])
}

enum InterestPostingStatus {
  ACCRUED // Booked to interestAccrued, payable at maturity
  CREDITED // Credited to the account balance
  REVERSED
}

enum AccountStatus {
  ACTIVE
  DORMANT
  FROZEN
  CLOSED
  MATURED
  TERMINATION_REQUESTED
  TERMINATED
  COMPLETED
}

// Savings Transactions
model SavingsTransaction {
  id        String @id @default(uuid())
  accountId String

  transactionRef  String                 @unique
  transactionType SavingsTransactionType

  amount        Decimal @db.Decimal(18, 2)
  balanceBefore Decimal @db.Decimal(18, 2)
  balanceAfter  Decimal @db.Decimal(18, 2)

  paymentMode      PaymentMode
  paymentReference String?

  description String?
  narration   String?

  processedById String
  processedAt   DateTime @default(now())

  valueDate      DateTime @default(now())
  journalEntryId String?

  // For reversals
  isReversed  Boolean   @default(false)
  reversedAt  DateTime?
  reversalRef String?

  createdAt DateTime @default(now())

  account     SavingsAccount @relation(fields: [accountId], references: [id])
  processedBy Staff          @relation(fields: [processedById], references: [id])

  @@index([accountId])
  @@index([transactionRef])
  @@index([processedAt])
  @@index([transactionType])
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST_CREDIT
  INTEREST_ACCRUAL
  MATURITY_PAYOUT
  TERMINATION_PAYOUT
  FEE_DEBIT
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
  ADJUSTMENT
}

// Withdrawal approval workflow
model WithdrawalRequest {
  id            String @id @default(uuid())
  requestNumber String @unique

  accountId String
  amount    Decimal @db.Decimal(18, 2)

  reason           String?
  paymentMode      PaymentMode @default(CASH)
