enum JournalEntryType {
  STANDARD
  OPENING
  CLOSING
  ADJUSTMENT
  REVERSAL
  ACCRUAL
  SYSTEM
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  REVERSED
}

// Journal Entry Lines (Double-Entry)
model JournalEntryLine {
